WORKER_NAME=prism-api
D1_DATABASE_NAME=prism
D1_DATABASE_ID=
D1_PREVIEW_DATABASE_ID=

# Unified platform deployment (--platform). Set in Workers Builds.
CLOUDFLARE_ACCOUNT_ID=
CUSTOM_DOMAIN=
APP_ORIGIN=https://your-worker.example.com
MUNET_CLIENT_ID=
APPLE_TEAM_ID=
ANDROID_CERT_FINGERPRINTS=
EXTRA_ALLOWED_ORIGINS=
RATE_LIMIT_KV_ID=

# Remote Live Activity delivery (optional). Both vars may be left empty: with no key the
# feature is inert. APNS_PRIVATE_KEY is the .p8 signing key contents and must be set as a
# secret instead -- `wrangler secret put APNS_PRIVATE_KEY --config wrangler.generated.jsonc`.
APNS_KEY_ID=
APNS_TEAM_ID=
