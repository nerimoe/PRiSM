{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["bun-types", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "test/**/*"],
  "references": [
    { "path": "../core" },
    { "path": "../application" },
    { "path": "../storage-sql" },
    { "path": "../adapter-d1" },
    { "path": "../adapter-sqlite" },
    { "path": "../runtime" }
  ]
}
