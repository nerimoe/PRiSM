{
  "name": "prism-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/adapter-d1",
    "packages/adapter-sqlite",
    "packages/application",
    "packages/bot-client",
    "packages/core",
    "packages/migration",
    "packages/rpc",
    "packages/runtime",
    "packages/server-hono",
    "packages/storage-sql"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "dev:local": "bun run packages/runtime/src/serve.ts",
    "dev:all": "bun run scripts/dev-all.ts",
    "prism-dashboard:analyze": "cd packages/prism-dashboard && flutter analyze --no-pub",
    "prism-dashboard:test": "cd packages/prism-dashboard && flutter test --no-pub",
    "prism-dashboard:build": "bun run scripts/release.ts build-dashboard",
    "wrangler:config": "bun run scripts/generate-wrangler-config.ts",
    "dev:worker": "bun run scripts/generate-wrangler-config.ts --local && wrangler dev --config wrangler.generated.jsonc",
    "deploy:worker": "bun run scripts/generate-wrangler-config.ts && bun run scripts/release.ts deploy-worker",
    "version:bump": "bun run scripts/release.ts bump",
    "db:create:d1": "wrangler d1 create prism",
    "db:migrate:local": "bun run scripts/generate-wrangler-config.ts --local && wrangler d1 migrations apply DB --config wrangler.generated.jsonc --local",
    "db:migrate:remote": "bun run scripts/generate-wrangler-config.ts && wrangler d1 migrations apply DB --config wrangler.generated.jsonc --remote",
    "migration:export-sqlite": "bun run packages/migration/src/cli.ts export-sqlite",
    "migration:export-postgres": "bun run packages/migration/src/cli.ts export-postgres",
    "migration:export-postgres-dump": "bun run packages/migration/src/cli.ts export-postgres-dump",
    "migration:import-json": "bun run packages/migration/src/cli.ts import-json"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "^5.9.3",
    "wrangler": "^4.98.0"
  }
}
